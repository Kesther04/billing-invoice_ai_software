generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}


// ─── Enums ────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  draft
  pending
  paid
  overdue
  cancelled
}

enum InvoiceSource {
  manual
  ai
}

enum OrganizationType {
  ORGANIZATION
  INDIVIDUAL
}

enum UserRole {
  OWNER     // Individual account owner
  ADMIN     // Creator of an organization
  MEMBER    // Invited team member
}

enum PromptRunStatus {
  success
  error
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  email     String           @unique
  type      OrganizationType
  inviteCode String?          @unique
  createdAt DateTime         @default(now())

  clients   Client[]
  invoices  Invoice[]
  users     User[]
  promptRuns   PromptRun[]
  // ← Add this back-relation (optional since organizationId? in token)
  passwordResetTokens PasswordResetToken[]
}

model User {
  id             String       @id @default(uuid())
  name           String
  email          String       @unique
  password       String
  role           UserRole
  organizationId String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // ← Add this back-relation
  passwordResetTokens PasswordResetToken[]
  invoices       Invoice[]
  promptRuns     PromptRun[]
  userSessions UserSession[]
}

model PasswordResetToken {
  id             String       @id @default(uuid())
  token          String       @unique
  userId         String
  organizationId String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Client ───────────────────────────────────────────────────────────────────

model Client {
  id             String   @id @default(uuid())
  name           String
  email          String?
  company        String?
  phone          String?
  address        String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  invoices     Invoice[]
}

// ─── Invoice ──────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(draft)
  source         InvoiceSource @default(manual)

  fromParty      Json
  toParty        Json

  issueDate      DateTime
  dueDate        DateTime

  subtotal       Float         @default(0)
  taxRate        Float         @default(0)
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  total          Float         @default(0)
  currency       String        @default("USD")

  notes          String?

  // AI metadata — present only when source = ai
  aiPrompt       String?       // the prompt that produced this invoice
  aiConfidence   Float?        // parser confidence score (future use)
  promptRunId    String?       // back-link to the PromptRun that generated it

  organizationId String
  clientId       String?
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])
  promptRun    PromptRun?   @relation(fields: [promptRunId], references: [id])

  lineItems    LineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@index([clientId])
}

// ─── LineItem ─────────────────────────────────────────────────────────────────

model LineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  total       Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── AI Prompt Runs (for audit log / regeneration) ─────────────────────────────────────────────

model PromptRun {
  id             String          @id @default(uuid())
  prompt         String
  status         PromptRunStatus
  error          String?         // present only when status = error
  draft  Json?           // the parsed draft — present only when status = success. NOT a live Invoice reference; snapshots the output at parse time so history is always accurate even if the invoice is later edited or deleted
  
  organizationId String
  createdById    String?
  createdAt      DateTime        @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  createdBy      User?           @relation(fields: [createdById], references: [id])

  invoices     Invoice[]     // invoices that were saved from this run

  @@index([organizationId])
  @@index([createdAt])

}

// ─── User Sessions (for storing refresh tokens) ─────────────────────────────────────────────

model UserSession {
  id           String   @id @default(uuid())

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash    String   @unique

  expiresAt    DateTime
  revokedAt    DateTime?

  ipAddress    String?
  userAgent    String?

  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}